<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="cleaner_arena">
    <!-- Simulation Physics Configuration -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Essential Gazebo Sim Systems / Plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Gravity & Atmosphere -->
    <gravity>0 0 -9.80665</gravity>

    <!-- Sun Light Source (Offline Native Definition) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane (Offline Native Definition) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Arena Model: 1.40m x 1.00m Playing Surface + LiDAR Perimeter Walls -->
    <model name="competition_arena">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- White Playing Surface (1.40m x 1.00m, 10mm thick) -->
      <link name="playing_field">
        <!-- Center at Z = 0.005 so top surface is exactly at Z = 0.01m -->
        <pose>0 0 0.005 0 0 0</pose>
        <collision name="field_collision">
          <geometry>
            <box>
              <size>1.40 1.00 0.01</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="field_visual">
          <geometry>
            <box>
              <size>1.40 1.00 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.95 0.95 1.0</ambient>
            <diffuse>0.95 0.95 0.95 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>

      <!-- North Wall (Black, 30mm thick, 150mm high) -->
      <link name="wall_north">
        <pose>0.0 0.515 0.085 0 0 0</pose>
        <collision name="wall_north_collision">
          <geometry>
            <box>
              <size>1.46 0.03 0.15</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_north_visual">
          <geometry>
            <box>
              <size>1.46 0.03 0.15</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1.0</ambient>
            <diffuse>0.1 0.1 0.1 1.0</diffuse>
            <specular>0.01 0.01 0.01 1.0</specular>
          </material>
        </visual>
      </link>

      <!-- South Wall (Black, 30mm thick, 150mm high) -->
      <link name="wall_south">
        <pose>0.0 -0.515 0.085 0 0 0</pose>
        <collision name="wall_south_collision">
          <geometry>
            <box>
              <size>1.46 0.03 0.15</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_south_visual">
          <geometry>
            <box>
              <size>1.46 0.03 0.15</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1.0</ambient>
            <diffuse>0.1 0.1 0.1 1.0</diffuse>
            <specular>0.01 0.01 0.01 1.0</specular>
          </material>
        </visual>
      </link>

      <!-- East Wall (Black, 30mm thick, 150mm high) -->
      <link name="wall_east">
        <pose>0.715 0.0 0.085 0 0 0</pose>
        <collision name="wall_east_collision">
          <geometry>
            <box>
              <size>0.03 1.00 0.15</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_east_visual">
          <geometry>
            <box>
              <size>0.03 1.00 0.15</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1.0</ambient>
            <diffuse>0.1 0.1 0.1 1.0</diffuse>
            <specular>0.01 0.01 0.01 1.0</specular>
          </material>
        </visual>
      </link>

      <!-- West Wall (Black, 30mm thick, 150mm high) -->
      <link name="wall_west">
        <pose>-0.715 0.0 0.085 0 0 0</pose>
        <collision name="wall_west_collision">
          <geometry>
            <box>
              <size>0.03 1.00 0.15</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_west_visual">
          <geometry>
            <box>
              <size>0.03 1.00 0.15</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1.0</ambient>
            <diffuse>0.1 0.1 0.1 1.0</diffuse>
            <specular>0.01 0.01 0.01 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target Collection Box (Variant 2 Rules: 210x210mm, 3x 100mm walls, 1x 300mm backboard) -->
    <!-- Located at top-right corner (X=+0.50m, Y=+0.30m), rotated 45 deg facing arena center -->
    <model name="target_box">
      <static>true</static>
      <!-- Placed on the arena surface at Z=0.01m, Yaw = -2.356194 rad (-135 deg) -->
      <pose>0.50 0.30 0.01 0 0 -2.356194</pose>

      <link name="target_box_link">
        <!-- 1. Base Plate (210mm x 210mm x 10mm) -->
        <collision name="base_collision">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry>
            <box>
              <size>0.21 0.21 0.01</size>
            </box>
          </geometry>
        </collision>
        <visual name="base_visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry>
            <box>
              <size>0.21 0.21 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.8 1.0</ambient>
            <diffuse>0.1 0.4 0.9 1.0</diffuse>
          </material>
        </visual>

        <!-- 2. Rear Wall / Backboard towards corner (300mm high, local -X direction) -->
        <collision name="backboard_collision">
          <pose>-0.10 0 0.16 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.21 0.30</size>
            </box>
          </geometry>
        </collision>
        <visual name="backboard_visual">
          <pose>-0.10 0 0.16 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.21 0.30</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.8 0.1 1.0</ambient>
            <diffuse>0.95 0.85 0.2 1.0</diffuse>
          </material>
        </visual>

        <!-- 3. Front Wall towards center (100mm high, local +X direction) -->
        <collision name="front_wall_collision">
          <pose>0.10 0 0.06 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.21 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="front_wall_visual">
          <pose>0.10 0 0.06 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.21 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.8 1.0</ambient>
            <diffuse>0.1 0.4 0.9 1.0</diffuse>
          </material>
        </visual>

        <!-- 4. Left Wall (100mm high, local +Y direction) -->
        <collision name="left_wall_collision">
          <pose>0 0.10 0.06 0 0 0</pose>
          <geometry>
            <box>
              <size>0.19 0.01 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="left_wall_visual">
          <pose>0 0.10 0.06 0 0 0</pose>
          <geometry>
            <box>
              <size>0.19 0.01 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.8 1.0</ambient>
            <diffuse>0.1 0.4 0.9 1.0</diffuse>
          </material>
        </visual>

        <!-- 5. Right Wall (100mm high, local -Y direction) -->
        <collision name="right_wall_collision">
          <pose>0 -0.10 0.06 0 0 0</pose>
          <geometry>
            <box>
              <size>0.19 0.01 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="right_wall_visual">
          <pose>0 -0.10 0.06 0 0 0</pose>
          <geometry>
            <box>
              <size>0.19 0.01 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.8 1.0</ambient>
            <diffuse>0.1 0.4 0.9 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>

