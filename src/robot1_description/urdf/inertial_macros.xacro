<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Analytical Inertia Tensor Multipliers -->
  <xacro:property name="BOX_INERTIA_FACTOR" value="${1.0 / 12.0}" />
  <xacro:property name="CYLINDER_RADIAL_FACTOR" value="${1.0 / 12.0}" />
  <xacro:property name="CYLINDER_AXIAL_FACTOR" value="${1.0 / 2.0}" />
  <xacro:property name="SPHERE_INERTIA_FACTOR" value="${2.0 / 5.0}" />

  <!-- Solid Rectangular Cuboid Inertia Macro -->
  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin" />
      <mass value="${mass}" />
      <inertia
        ixx="${BOX_INERTIA_FACTOR * mass * (y * y + z * z)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${BOX_INERTIA_FACTOR * mass * (x * x + z * z)}"
        iyz="0.0"
        izz="${BOX_INERTIA_FACTOR * mass * (x * x + y * y)}" />
    </inertial>
  </xacro:macro>

  <!-- Solid Cylinder Inertia Macro (symmetry axis along local Z) -->
  <xacro:macro name="inertial_cylinder" params="mass length radius *origin">
    <inertial>
      <xacro:insert_block name="origin" />
      <mass value="${mass}" />
      <inertia
        ixx="${CYLINDER_RADIAL_FACTOR * mass * (3.0 * radius * radius + length * length)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${CYLINDER_RADIAL_FACTOR * mass * (3.0 * radius * radius + length * length)}"
        iyz="0.0"
        izz="${CYLINDER_AXIAL_FACTOR * mass * (radius * radius)}" />
    </inertial>
  </xacro:macro>

  <!-- Solid Sphere Inertia Macro -->
  <xacro:macro name="inertial_sphere" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin" />
      <mass value="${mass}" />
      <inertia
        ixx="${SPHERE_INERTIA_FACTOR * mass * (radius * radius)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${SPHERE_INERTIA_FACTOR * mass * (radius * radius)}"
        iyz="0.0"
        izz="${SPHERE_INERTIA_FACTOR * mass * (radius * radius)}" />
    </inertial>
  </xacro:macro>
</robot>

